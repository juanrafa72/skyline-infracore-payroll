DATABASE_URL="postgresql://USUARIO@localhost:5432/payroll_dev?schema=public"
SESSION_SECRET="cadena-aleatoria-de-al-menos-32-caracteres"

# SOLO para servir la app en la red de la oficina por http://<mac>.local:3100
# (npm run start corre con NODE_ENV=production y marca la cookie de sesión como
# "secure"; los navegadores descartan esas cookies por HTTP simple y el login se
# vuelve un bucle). En un sitio publicado con HTTPS esta variable NO va.
SESSION_COOKIE_SECURE=false

# ── Envío de reportes por correo ─────────────────────────────
