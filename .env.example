# cada envío, pero NO manda el correo, y lo dice en pantalla. Nunca marca como
# enviado algo que no salió.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=nomina@skylinenext.com
# SMTP_PASS=
